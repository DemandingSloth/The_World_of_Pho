[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/multiplayer/piece_selection_ui.gd" id="1"]

[node name="PieceSelection" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 40
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="VBox" unique_name_in_owner=true]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Select Your Pieces"
horizontal_alignment = 1

[node name="TopRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="TimerLabel" type="Label" parent="VBox/TopRow" unique_name_in_owner=true]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Time: 120 s"

[node name="CountLabel" type="Label" parent="VBox/TopRow" unique_name_in_owner=true]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Selected: 0 / 20 (min 3)"
horizontal_alignment = 2

[node name="Spacer1" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

[node name="ListsRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="InventoryPanel" type="VBoxContainer" parent="VBox/ListsRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="InvLabel" type="Label" parent="VBox/ListsRow/InventoryPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Your Inventory"
horizontal_alignment = 1

[node name="InventoryList" type="ItemList" parent="VBox/ListsRow/InventoryPanel" unique_name_in_owner=true]
layout_mode = 2
size_flags_vertical = 3
allow_reselect = true
auto_height = false

[node name="ButtonPanel" type="VBoxContainer" parent="VBox/ListsRow"]
layout_mode = 2
custom_minimum_size = Vector2(100, 0)
alignment = 1
theme_override_constants/separation = 10

[node name="AddBtn" type="Button" parent="VBox/ListsRow/ButtonPanel" unique_name_in_owner=true]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Add →"

[node name="RemoveBtn" type="Button" parent="VBox/ListsRow/ButtonPanel" unique_name_in_owner=true]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "← Remove"

[node name="SelectedPanel" type="VBoxContainer" parent="VBox/ListsRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="SelLabel" type="Label" parent="VBox/ListsRow/SelectedPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Battle Hand"
horizontal_alignment = 1

[node name="SelectedList" type="ItemList" parent="VBox/ListsRow/SelectedPanel" unique_name_in_owner=true]
layout_mode = 2
size_flags_vertical = 3
allow_reselect = true
auto_height = false

[node name="Spacer2" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

[node name="ErrorLabel" type="Label" parent="VBox" unique_name_in_owner=true]
layout_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
text = ""
horizontal_alignment = 1
visible = false

[node name="StatusLabel" type="Label" parent="VBox" unique_name_in_owner=true]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = ""
horizontal_alignment = 1

[node name="Spacer3" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

[node name="BtnRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ConfirmBtn" type="Button" parent="VBox/BtnRow" unique_name_in_owner=true]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Confirm Selection"
disabled = true

[node name="CancelBtn" type="Button" parent="VBox/BtnRow" unique_name_in_owner=true]
layout_mode = 2
